# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# secrets, keys & certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json
credentials.json
client_secret*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (never commit secrets)
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# markdown files
*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

config.bat
